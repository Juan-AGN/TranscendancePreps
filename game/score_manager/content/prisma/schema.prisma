// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      Int     @id @default(autoincrement())
  name    String

  matchesAsOne   Match[] @relation("UserOne")
  matchesAsTwo   Match[] @relation("UserTwo")
  matchesAsThree Match[] @relation("UserThree")
  matchesAsFour  Match[] @relation("UserFour")

  score   Int
}

model Match {
  id      Int      @id @default(autoincrement())

  firstId   Int
  first     User     @relation("UserOne", fields: [firstId], references: [id], onDelete: Cascade)

  secondId   Int
  second     User     @relation("UserTwo", fields: [secondId], references: [id], onDelete: Cascade)

  thirdId Int?
  third   User?    @relation("UserThree", fields: [thirdId], references: [id], onDelete: Cascade)

  fourthId  Int?
  fourth    User?    @relation("UserFour", fields: [fourthId], references: [id], onDelete: Cascade)

  players     Int

  fdate DateTime @default(now())
}
