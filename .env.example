# ============================================
# DATABASE
# ============================================
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
CHAT_POSTGRES_USER=your_chat_user
CHAT_POSTGRES_PASSWORD=your_chat_password
CHAT_POSTGRES_DB=your_chat_db

DATABASE_URL="postgresql://your_db_user:your_db_password@db:5432/your_db_name"
CHAT_DATABASE_URL="postgresql://your_chat_user:your_chat_password@db:5432/your_chat_db"
# ============================================
# SECURITY
# ============================================
JWT_SECRET=your_jwt_secret_here

# ============================================
# SERVER
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# OAUTH 42
# ============================================
FORTY_TWO_CLIENT_ID=your_42_client_id
FORTY_TWO_CLIENT_SECRET=your_42_client_secret
FORTY_TWO_REDIRECT_URI=https://localhost:8889/api/auth/42/callback
FRONTEND_URL=https://localhost:8889