// ============================================================================
// CONFIGURACION DE PRISMA
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TABLA(model): Usuario
// ============================================================================
model Usuario {
  id        Int       @id @default(autoincrement())
  nombre    String
  email     String    @unique
  password  String?
  avatar    String?   @default("default-avatar.png")  
  estadoOnline Boolean @default(false)
  ultimaConexion DateTime?
  createdAt DateTime  @default(now())
  fortyTwoId Int?     @unique
  
  // RELACIONES ( NO son columnas reales sino campos virtuales)
  solicitudesEnviadas  Amistad[] @relation("SolicitudesEnviadas")
  solicitudesRecibidas Amistad[] @relation("SolicitudesRecibidas")
  
  // Nombre exacto de la tabla en PostgreSQL ( sin esto Prisma la llamaría en minúscula)
  @@map("Usuario")
}

// ============================================================================
// TABLA(model): Amistad
// ============================================================================
model Amistad {
  id            Int      @id @default(autoincrement())
  solicitanteId Int
  receptorId    Int
  estado        String   @default("pendiente")
  createdAt     DateTime @default(now())
  
  // Relaciones
                      // 
  solicitante Usuario @relation("SolicitudesEnviadas", fields: [solicitanteId], references: [id])
  receptor    Usuario @relation("SolicitudesRecibidas", fields: [receptorId], references: [id])
  
  @@map("Amistad")
}
