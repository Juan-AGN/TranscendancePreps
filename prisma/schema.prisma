// ============================================================================
// CONFIGURACION DE PRISMA
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MODELO: Usuario
// ============================================================================
model Usuario {
  id        Int       @id @default(autoincrement())
  nombre    String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  
  // Relaciones
  solicitudesEnviadas  Amistad[] @relation("SolicitudesEnviadas")
  solicitudesRecibidas Amistad[] @relation("SolicitudesRecibidas")
  posts                Post[]    @relation("PostsDelUsuario")
  
  @@map("Usuario")
}

// ============================================================================
// MODELO: Amistad
// ============================================================================
model Amistad {
  id            Int      @id @default(autoincrement())
  solicitanteId Int
  receptorId    Int
  estado        String   @default("pendiente")
  createdAt     DateTime @default(now())
  
  // Relaciones
  solicitante Usuario @relation("SolicitudesEnviadas", fields: [solicitanteId], references: [id])
  receptor    Usuario @relation("SolicitudesRecibidas", fields: [receptorId], references: [id])
  
  @@map("Amistad")
}

// ============================================================================
// MODELO: Post
// ============================================================================
model Post {
  id        Int      @id @default(autoincrement())
  contenido String
  createdAt DateTime @default(now())
  usuarioId Int
  
  // Relación
  usuario Usuario @relation("PostsDelUsuario", fields: [usuarioId], references: [id])
  
  @@map("Post")
}