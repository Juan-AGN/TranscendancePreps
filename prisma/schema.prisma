generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nombre    String
  password  String
  createdAt DateTime @default(now())
  
  amistadesSolicitadas Amistad[] @relation("UsuarioSolicitante")
  amistadesPendientes  Amistad[] @relation("UsuarioReceptor")
  posts                Post[]
}

model Amistad {
  id            Int      @id @default(autoincrement())
  solicitanteId Int
  receptorId    Int
  estado        String
  createdAt     DateTime @default(now())
  
  solicitante Usuario @relation("UsuarioSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  receptor    Usuario @relation("UsuarioReceptor", fields: [receptorId], references: [id], onDelete: Cascade)
  
  @@unique([solicitanteId, receptorId])
}

model Post {
  id        Int      @id @default(autoincrement())
  contenido String
  usuarioId Int
  createdAt DateTime @default(now())
  
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}